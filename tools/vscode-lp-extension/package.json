{
  "name": "vscode-lp-extension",
  "displayName": "Logic LP Tools",
  "description": "Syntax highlighting, diagnostics, and class queries for .lp logic programs.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:logic-lp",
    "onCommand:lp.showClassCurrentFile",
    "onCommand:lp.showClassWorkspace",
    "onCommand:lp.showInheritanceCurrentFile",
    "onCommand:lp.refreshWorkspaceIndex"
  ],
  "main": "./src/extension.js",
  "files": [
    "language-configuration.json",
    "python_backend",
    "README.md",
    "src",
    "syntaxes",
    "tsconfig.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "logic-lp",
        "aliases": [
          "Logic LP",
          "logic-lp"
        ],
        "extensions": [
          ".lp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "logic-lp",
        "scopeName": "source.logic-lp",
        "path": "./syntaxes/logic-lp.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "lp.showClassCurrentFile",
        "title": "LP: Show Class (Current File)"
      },
      {
        "command": "lp.showClassWorkspace",
        "title": "LP: Show Class (Workspace)"
      },
      {
        "command": "lp.showInheritanceCurrentFile",
        "title": "LP: Show Inheritance (Current File)"
      },
      {
        "command": "lp.refreshWorkspaceIndex",
        "title": "LP: Refresh Workspace Index"
      }
    ],
    "configuration": {
      "title": "Logic LP",
      "properties": {
        "lp.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used to run the Logic LP backend."
        },
        "lp.backendScriptsRoot": {
          "type": "string",
          "default": "${extensionPath}/python_backend/scripts",
          "description": "Path to the bundled logic-language parser scripts."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.6.3"
  }
}
