{
  "scopeName": "source.logic-lp",
  "name": "Logic LP",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#headings"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.logic-lp",
          "match": "#.*$"
        }
      ]
    },
    "headings": {
      "patterns": [
        {
          "name": "markup.heading.logic-lp",
          "match": "^\\s*@.*$"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "keyword.control.import.logic-lp"
            },
            "2": {
              "name": "string.unquoted.import-path.logic-lp"
            }
          },
          "match": "^(\\s*\\$import)\\s+(.*)$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.logic-lp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.logic-lp",
              "match": "\\\\[\\\\\"nrt]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.logic-lp",
          "match": "(?<![\\w'])-?\\d+(?:\\.\\d+)?"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "entity.name.function.member.logic-lp"
            },
            "2": {
              "name": "keyword.operator.member.logic-lp"
            }
          },
          "match": "(?<![\\w'])([A-Za-z_][A-Za-z0-9_']*)(\\s*::)"
        },
        {
          "captures": {
            "1": {
              "name": "entity.name.function.logic-lp"
            },
            "2": {
              "name": "keyword.operator.declaration.logic-lp"
            }
          },
          "match": "(?<![\\w'])([A-Za-z_][A-Za-z0-9_']*)(\\s*:)(?!:)"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.quantifier.logic-lp",
          "match": "[\\u2200\\u2203]"
        },
        {
          "name": "keyword.control.logic-lp",
          "match": "\\b(sum|max|min|condition|else)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logic-lp",
          "match": "::|:=:|=>|->|\\|-|&&|\\|\\||[=~:+\\-*/^<>!|]"
        },
        {
          "name": "keyword.operator.logic-lp",
          "match": "[\\u2208\\u2209\\u222A\\u2229\\u2264\\u2265\\u2260]"
        }
      ]
    }
  }
}
