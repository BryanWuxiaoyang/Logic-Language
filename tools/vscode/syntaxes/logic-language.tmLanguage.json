{
  "scopeName": "source.logic-language",
  "name": "Logic Language",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#members"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#quantifiers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.logic-language",
          "match": "#.*$"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "keyword.control.import.logic-language"
            },
            "2": {
              "name": "string.unquoted.import-path.logic-language"
            }
          },
          "match": "^(\\s*\\$import)\\s+(.*)$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.logic-language",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.logic-language",
              "match": "\\\\[\\\\\"nrt]"
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "entity.name.function.method.logic-language"
            }
          },
          "match": "(?<=::)\\s*([a-z][A-Za-z0-9_]*)\\s*(?=:)"
        },
        {
          "captures": {
            "1": {
              "name": "entity.name.function.logic-language"
            }
          },
          "match": "(?<!:)\\b([a-z][A-Za-z0-9_]*)\\s*(?=:)"
        },
        {
          "captures": {
            "1": {
              "name": "variable.other.member.logic-language"
            }
          },
          "match": "(?<=::)\\s*([a-z][A-Za-z0-9_]*)\\b(?!\\s*:)"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "variable.other.member.logic-language"
            }
          },
          "match": "\\.\\s*([A-Za-z_][A-Za-z0-9_]*)"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "entity.name.function.logic-language"
            }
          },
          "match": "\\b([a-z][A-Za-z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.class.logic-language",
          "match": "\\b(?:Function|Predicate|Set|Bool|Symbol|Value|Tuple|List|String|Char|Num|Size)\\b"
        },
        {
          "name": "constant.language.boolean.logic-language",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.logic-language",
          "match": "(?<![A-Za-z_])(?:0[xX][0-9A-Fa-f]+|\\d+(?:\\.\\d+)?)(?![A-Za-z_])"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.type.class.logic-language",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "variable.other.local.logic-language",
          "match": "\\b_[a-z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "quantifiers": {
      "patterns": [
        {
          "name": "keyword.control.quantifier.logic-language",
          "match": "[\\u2200\\u2203]"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logic-language",
          "match": "=>|::|:=:|->|&&|\\|\\||[=~:+\\-*/^<>!|]"
        },
        {
          "name": "keyword.operator.logic-language",
          "match": "[\\u2208\\u2209\\u222A\\u2229\\u2264\\u2265\\u2260]"
        }
      ]
    }
  }
}
